# Enquiry form delivery (Amazon SES v2). Without these, dev accepts submissions but
# doesn't send; production fails closed and shows a "please call us" error.
SES_REGION=ap-southeast-2
ENQUIRY_FROM_EMAIL=            # must be a verified SES identity (domain or address)
ENQUIRY_TO_EMAIL=              # comma-separated for multiple recipients
# Credentials: set these, OR leave blank to use the default AWS chain (IAM role / AWS_* vars)
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional
SES_CONFIGURATION_SET=
NEXT_PUBLIC_SITE_URL=
